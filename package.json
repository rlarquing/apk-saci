{
  "name": "apk-saci",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo start --offline",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "prebuild": "npx expo prebuild --no-install -p android",
    "clear": "npx expo start --offline --clear",
    "build-apk": "eas build -p android --profile preview",
    "build-apk-local": "npx expo prebuild -p android --no-install && cd android && gradlew.bat assembleRelease --stacktrace"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.17",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^19.2.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
