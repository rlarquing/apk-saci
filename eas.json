{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "credentialsSource": "local",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_URL": "http://TU-SERVIDOR-SACI:3000/api"
        }
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_API_URL": "http://TU-SERVIDOR-SACI:3000/api"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
